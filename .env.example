# Never commit a real key. Copy this file to .env for local development.
GOOGLE_API_KEY=replace_with_your_key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REVIEW_MODEL=gemini-3.7-flash

APP_ENV=local
LOG_LEVEL=INFO
OUTPUT_DIR=outputs

# Tracing is off unless explicitly enabled.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=intake-trace
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=
